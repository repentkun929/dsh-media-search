{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/*": ["./node_modules/@deepseek-ai/*"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/fragment.ts"]
}
